import QtQuick
import Quickshell
import Quickshell.Io
import qs.Commons as Commons
import @PLUGIN@ as Plugin

ShellRoot {
  id: root
  property int frame: 0
  property int frameCount: @COUNT@
  property var heights: []
  property string output: @OUTPUT@
  property real time: 0

  QtObject {
    id: demo
    property var statusModel: ({})
    function request(value) {}
    function requestVolume(value, finalValue) {}
  }
  QtObject {
    id: demoBar
    property color foreground: "#e8eee5"
    property color barForeground: foreground
    property color background: "#151b1d"
    property color urgent: "#ef826d"
    property string fontFamily: "CaskaydiaMono Nerd Font"
  }
  FloatingWindow {
    id: window
    visible: true
    color: "transparent"
    implicitWidth: 660
    implicitHeight: 650
    Item {
      id: stage
      width: 660
      readonly property var panelItem: {
        for (var i = 0; i < content.children.length; i++) {
          if (content.children[i].promoPanel) return content.children[i]
        }
        return null
      }
      height: panelItem ? panelItem.height : 300
      Plugin.ArctisPanel { id: content; service: demo; bar: demoBar; width: stage.width }
      Canvas {
        id: pointer
        z: 100
        width: 26
        height: 35
        visible: false
        onPaint: {
          var ctx = getContext("2d")
          ctx.clearRect(0, 0, width, height)
          ctx.beginPath()
          ctx.moveTo(2, 2); ctx.lineTo(2, 26); ctx.lineTo(9, 20)
          ctx.lineTo(15, 32); ctx.lineTo(20, 29); ctx.lineTo(14, 18)
          ctx.lineTo(24, 18); ctx.closePath()
          ctx.fillStyle = "#c6f777"; ctx.fill()
          ctx.strokeStyle = "#151b1d"; ctx.lineWidth = 2; ctx.stroke()
        }
      }
    }
  }
  function pose(t) {
    root.time = t
    var gameVolume = Math.round(100 - 38 * smooth((t - 9.4) / 1.4))
    var game = gameVolume, chat = 100
    if (t >= 3 && t < 9) {
      var wave = Math.sin((t - 3) * Math.PI / 3)
      game = Math.round(100 * (1 - Math.max(0, -wave)))
      chat = Math.round(100 * (1 - Math.max(0, wave)))
    }
    var offline = t >= 15 && t < 22
    demo.statusModel = {
      online: !offline, receiver: true, battery: offline ? null : 58,
      charging: false, ready: true, defaultGame: true,
      game: gameVolume, chat: 100,
      effectiveGame: game, effectiveChat: chat,
      wheelAvailable: !offline, followWheel: true,
      error: "", controlError: "", sidetone: 1, sleep: 15, alerts: true,
      fallback: "desktop", fallbackAvailable: true, fallbackActive: offline,
      fallbackVolume: Math.round(45 + 15 * smooth((t - 17) / 1.8)),
      outputs: [{name: "desktop", label: "Desktop speakers", available: true},
                {name: "hdmi", label: "Digital Stereo (HDMI) [Gaming monitor]", available: true}],
      apps: t >= 22 && t < 26 ? [
        {id: 1, key: "game", name: "Your game", channel: "arctis_game"},
        {id: 2, key: "voice", name: "Voice chat", channel: "arctis_chat"}
      ] : [], ruleCount: 0
    }
    content.moreExpanded = t >= 12 && t < 15
    content.appsExpanded = t >= 22 && t < 26
  }
  function smooth(value) {
    var x = Math.max(0, Math.min(1, value))
    return x * x * (3 - 2 * x)
  }
  function descendants(item, predicate, result) {
    if (predicate(item)) result.push(item)
    for (var i = 0; i < item.children.length; i++)
      descendants(item.children[i], predicate, result)
  }
  function prepareViewport() {
    var viewports = []
    descendants(content, function(item) {
      return item.contentY !== undefined && item.flickableDirection !== undefined
    }, viewports)
    if (viewports.length) {
      var viewport = viewports[0]
      viewport.contentY = 0
      if (viewport.contentHeight > viewport.height + 1) {
        console.error("Preview content would be clipped at frame " + frame
          + ": " + viewport.contentHeight + " > " + viewport.height)
        Qt.quit()
        return
      }
    }
    var sliders = []
    descendants(content, function(item) {
      return item.minimum === 0 && item.maximum === 100 && item.liveValue !== undefined
    }, sliders)
    var slider = time >= 9.2 && time < 11.2 ? sliders[0]
      : time >= 16.8 && time < 19.2 ? sliders[2] : null
    pointer.visible = !!slider
    if (slider) {
      var point = slider.mapToItem(stage, Math.max(0, Math.min(slider.width - slider.knobSize,
        slider.width * slider.progress - slider.knobSize / 2)) + slider.knobSize / 2, slider.height / 2)
      pointer.x = point.x + 2
      pointer.y = point.y + 2
      pointer.requestPaint()
    }
    paintFrame.restart()
  }
  function capture() {
    if (frame >= frameCount) {
      metadata.command = ["python3", "-c", "import pathlib,sys;pathlib.Path(sys.argv[1]).write_text(sys.argv[2])",
        output + "/heights.json", JSON.stringify(heights)]
      metadata.running = true
      return
    }
    pose(frame / 30)
    // Let the native controls finish their layout before choosing grab dimensions.
    settleFrame.restart()
  }
  function grabFrame() {
    stage.grabToImage(function(result) {
      var name = ("00000" + root.frame).slice(-5)
      if (!result.saveToFile(output + "/" + name + ".png")) {
        console.error("Could not save preview frame " + name)
        Qt.quit()
        return
      }
      root.heights.push(stage.height)
      root.frame++
      if (root.frame % 150 === 0) console.log("Captured " + root.frame + "/" + root.frameCount)
      nextFrame.restart()
    }, Qt.size(stage.width * 2, Math.ceil(stage.height) * 2))
  }
  Process { id: metadata; onExited: Qt.quit() }
  Timer { id: nextFrame; interval: 1; onTriggered: root.capture() }
  Timer { id: settleFrame; interval: 32; onTriggered: root.prepareViewport() }
  Timer { id: paintFrame; interval: 16; onTriggered: root.grabFrame() }
  Timer {
    interval: 1200
    running: true
    onTriggered: {
      Commons.Style.reduceMotion = true
      Commons.Color.background = "#151b1d"
      Commons.Color.foreground = "#e8eee5"
      Commons.Color.accent = "#c6f777"
      Commons.Color.shellValues = {"popups.background": "#151b1d", "popups.text": "#e8eee5", "popups.border": "#46524b"}
      content.open()
      root.capture()
    }
  }
}
